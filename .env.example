# Apk Moby — local / docs reference for secrets
# On Cloudflare Pages: Settings → Environment variables (Production)
# Never commit real secret values.

# --- Existing admin/CMS ---
ADMIN_EMAIL=ali.niamat.nazir@gmail.com
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_SALT=apkmoby.admin.v1
SESSION_SECRET=
GITHUB_TOKEN=
GITHUB_REPO=linkofydev/apkmoby
GITHUB_BRANCH=main
PUBLIC_SITE_URL=https://apkmoby.com

# --- Remote APK → Cloudflare R2 ---
# Create R2 API token: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# Permission: Object Read & Write on bucket apkmoby-files
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=apkmoby-files
DOWNLOAD_DOMAIN=https://dl.apkmoby.com

# Optional: bind R2 natively on the Pages project (preferred streaming path).
# In wrangler.toml / Pages settings:
# [[r2_buckets]]
# binding = "APK_BUCKET"
# bucket_name = "apkmoby-files"
