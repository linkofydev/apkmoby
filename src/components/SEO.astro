---
import { SITE, absoluteUrl } from '../config';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  robots?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  image = SITE.defaultOgImage,
  type = 'website',
  robots,
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const canonicalUrl = absoluteUrl(canonical);
const imageUrl = absoluteUrl(image);
const robotsContent = robots ?? (noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1');
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const cleanDescription = description.replace(/\s+/g, ' ').trim().slice(0, 160);
---

<title>{fullTitle}</title>
<meta name="description" content={cleanDescription} />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content={robotsContent} />
<meta name="googlebot" content={robotsContent} />
<meta name="author" content={SITE.author} />
<meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#070b14" media="(prefers-color-scheme: dark)" />
<meta name="format-detection" content="telephone=no" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={cleanDescription} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={title} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE.twitter} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={cleanDescription} />
<meta name="twitter:image" content={imageUrl} />

<link rel="sitemap" href="/sitemap.xml" />
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href="/rss.xml" />
