---
import { formatDownloads } from '../lib/apk';
import type { ApkEntry } from '../lib/apk';

interface Props {
  app: ApkEntry;
}

const { app } = Astro.props;
const { data } = app;

const rows = [
  ['Version', data.version],
  ['Size', data.size],
  ['Developer', data.developer],
  ['Android', data.reqAndroid],
  ['Package', data.packageName],
  ['Downloads', formatDownloads(data.totalDownloads)],
  ['Rating', `${data.ratingValue.toFixed(1)} (${data.ratingCount.toLocaleString()} reviews)`],
  ['Updated', data.updatedDate.toISOString().slice(0, 10)],
];
---

<div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800">
  <table class="w-full text-sm">
    <caption class="sr-only">{data.appName} specifications</caption>
    <tbody>
      {
        rows.map(([label, value], i) => (
          <tr class:list={[i % 2 === 0 ? 'bg-slate-50 dark:bg-ink-raised' : 'bg-white dark:bg-ink-card']}>
            <th scope="row" class="w-32 px-4 py-2.5 text-left font-medium text-slate-500 dark:text-slate-400">
              {label}
            </th>
            <td class="px-4 py-2.5 text-center text-slate-800 dark:text-slate-200">{value}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
