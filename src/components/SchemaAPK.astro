---
import { absoluteUrl, applicationCategory } from '../config';
import type { ApkEntry } from '../lib/apk';

interface Props {
  app: ApkEntry;
}

const { app } = Astro.props;
const { data } = app;
const url = absoluteUrl(`/${data.slug}`);
const screenshots = (data.screenshots || []).filter(Boolean);

const schema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: data.appName,
  description: data.metaDescription,
  url,
  image: absoluteUrl(data.featuredImage || data.icon),
  operatingSystem: 'Android',
  applicationCategory: applicationCategory(data.category),
  applicationSubCategory: data.category,
  softwareVersion: String(data.version),
  fileSize: String(data.size),
  softwareRequirements: `Android ${data.reqAndroid}`,
  downloadUrl: absoluteUrl(`/download/${data.slug}`),
  installUrl: absoluteUrl(`/download/${data.slug}`),
  datePublished: data.publishDate.toISOString(),
  dateModified: data.updatedDate.toISOString(),
  author: {
    '@type': 'Organization',
    name: data.developer,
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
};

if (screenshots.length) {
  schema.screenshot = screenshots.map((src) => absoluteUrl(src));
}

if (data.ratingCount > 0 && data.ratingValue > 0) {
  schema.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: data.ratingValue,
    ratingCount: data.ratingCount,
    bestRating: 5,
    worstRating: 1,
  };
}
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
