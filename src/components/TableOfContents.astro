---
interface TocItem {
  id: string;
  label: string;
}

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <nav
      id="table-of-contents"
      class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-ink-card"
      aria-labelledby="toc-heading"
    >
      <h2 id="toc-heading" class="text-lg font-bold text-slate-900 dark:text-white">
        Table of Contents
      </h2>
      <ol class="mt-3 space-y-2 text-sm">
        {items.map((item, i) => (
          <li>
            <a
              href={`#${item.id}`}
              class="inline-flex gap-2 text-cyan-700 transition-colors hover:text-cyan-500 dark:text-cyan-300 dark:hover:text-cyan-200"
            >
              <span class="tabular-nums text-slate-400">{i + 1}.</span>
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
