---
interface TocItem {
  id: string;
  label: string;
}

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <details
      id="table-of-contents"
      class="group rounded-2xl border border-slate-200 bg-white shadow-sm open:shadow-md dark:border-slate-700 dark:bg-ink-card"
    >
      <summary
        class="flex cursor-pointer list-none items-center justify-between gap-3 px-5 py-3.5 text-sm font-semibold text-slate-800 marker:content-none [&::-webkit-details-marker]:hidden dark:text-slate-100"
      >
        <span class="inline-flex items-center gap-2">
          <svg class="h-4 w-4 text-cyan-600 dark:text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"></path>
          </svg>
          Table of Contents
        </span>
        <svg
          class="h-4 w-4 shrink-0 text-slate-400 transition-transform group-open:rotate-180"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M6 9l6 6 6-6"></path>
        </svg>
      </summary>
      <nav class="border-t border-slate-100 px-5 py-4 dark:border-slate-700" aria-label="Table of contents">
        <ol class="space-y-2 text-sm">
          {items.map((item, i) => (
            <li>
              <a
                href={`#${item.id}`}
                class="inline-flex gap-2 text-slate-600 transition-colors hover:text-cyan-600 dark:text-slate-300 dark:hover:text-cyan-300"
              >
                <span class="tabular-nums text-slate-400">{i + 1}.</span>
                <span>{item.label}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  )
}
