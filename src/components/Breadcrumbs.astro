---
import { absoluteUrl } from '../config';

export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: absoluteUrl(item.href) } : {}),
  })),
};
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex flex-wrap items-center gap-1.5 text-sm text-slate-500 dark:text-slate-400">
    {
      items.map((item, index) => (
        <li class="flex items-center gap-1.5">
          {index > 0 && (
            <span aria-hidden="true" class="text-slate-400 dark:text-slate-600">
              /
            </span>
          )}
          {item.href && index !== items.length - 1 ? (
            <a
              href={item.href}
              class="transition-colors hover:text-cyan-600 dark:hover:text-cyan-300"
            >
              {item.label}
            </a>
          ) : (
            <span class="font-medium text-slate-800 dark:text-slate-200" aria-current="page">
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
