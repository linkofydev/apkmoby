---
import { SITE, NAV, categorySlug } from '../config';
import { getApks, uniqueCategories } from '../lib/apk';

const liveCats = uniqueCategories(await getApks());
const navHrefs = new Set(NAV.map((item) => item.href));
const navLabels = new Set(NAV.map((item) => item.label.toLowerCase()));
const extraCats = liveCats
  .map((cat) => ({ href: `/category/${categorySlug(cat)}`, label: cat }))
  .filter((item) => !navHrefs.has(item.href) && !navLabels.has(item.label.toLowerCase()));
const mobileLinks = [...NAV, ...extraCats];
---

<header
  class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 text-slate-900 backdrop-blur-md dark:border-white/10 dark:bg-ink/70 dark:text-white"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4">
    <a href="/" class="flex items-center gap-2 font-bold tracking-tight">
      <span
        class="grid h-8 w-8 place-items-center rounded-lg bg-linear-to-br from-cyan-400 to-violet-500 text-sm text-ink shadow-glow"
        aria-hidden="true"
      >
        AM
      </span>
      <span>{SITE.name}</span>
    </a>
    <nav aria-label="Primary" class="hidden items-center gap-5 text-sm font-medium md:flex">
      {
        NAV.map((item) => (
          <a href={item.href} class="text-slate-600 transition-colors hover:text-cyan-600 dark:text-slate-300 dark:hover:text-cyan-300">
            {item.label}
          </a>
        ))
      }
      {
        extraCats.slice(0, 4).map((item) => (
          <a href={item.href} class="text-slate-600 transition-colors hover:text-cyan-600 dark:text-slate-300 dark:hover:text-cyan-300">
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2">
      <button
        type="button"
        id="theme-toggle"
        class="grid h-9 w-9 place-items-center rounded-lg border border-slate-200 text-slate-700 transition-colors hover:border-cyan-400 dark:border-white/15 dark:text-slate-200"
        aria-label="Toggle color theme"
      >
        <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z"></path>
        </svg>
        <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
      </button>
      <details class="relative md:hidden">
        <summary class="grid h-9 w-9 list-none place-items-center rounded-lg border border-slate-200 dark:border-white/15 [&::-webkit-details-marker]:hidden">
          <span class="sr-only">Menu</span>
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <div class="absolute right-0 mt-2 w-44 rounded-xl border border-slate-200 bg-white p-2 shadow-lg dark:border-white/10 dark:bg-ink-card">
          {
            mobileLinks.map((item) => (
              <a href={item.href} class="block rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-white/5">
                {item.label}
              </a>
            ))
          }
        </div>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.classList.contains('dark') ? 'light' : 'dark';
    root.classList.toggle('dark', next === 'dark');
    localStorage.setItem('theme', next);
  });
</script>
