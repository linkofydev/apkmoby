---
import OptimizedImage from './OptimizedImage.astro';
import type { ApkEntry } from '../lib/apk';

interface Props {
  app: ApkEntry;
}

const { app } = Astro.props;
const { data } = app;
const isMod = data.modFeatures.length > 0;
---

<a
  href={`/${data.slug}`}
  data-app={`${data.appName} ${data.category} ${data.modFeatures.join(' ')}`}
  class="group flex w-[7.25rem] shrink-0 flex-col items-center gap-2 rounded-2xl p-2 text-center transition hover:-translate-y-1"
>
  <span class="relative">
    <OptimizedImage
      src={data.icon}
      alt=""
      width={72}
      height={72}
      class="h-[72px] w-[72px] rounded-[1.35rem] border border-white/20 shadow-lg shadow-black/30"
    />
    {
      isMod && (
        <span class="absolute -right-1 -top-1 rounded-full bg-violet-500 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-white">
          MOD
        </span>
      )
    }
  </span>
  <span class="line-clamp-2 min-h-[2.4em] text-[13px] font-medium leading-tight text-slate-800 dark:text-slate-100">
    {data.appName}
  </span>
  <span class="text-[11px] text-slate-500 dark:text-slate-400">v{data.version}</span>
</a>
