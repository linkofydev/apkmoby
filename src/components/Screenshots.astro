---
import OptimizedImage from './OptimizedImage.astro';

interface Props {
  appName: string;
  screenshots: string[];
}

const { appName, screenshots } = Astro.props;
const shots = (screenshots || []).map((src) => String(src || '').trim()).filter(Boolean);
---

{
  shots.length > 0 && (
    <section aria-labelledby="shots-heading">
      <h2 id="shots-heading" class="mb-4 text-xl font-bold text-slate-900 dark:text-white">
        Screenshots
      </h2>
      <div class="shot-track -mx-4 flex gap-4 overflow-x-auto px-4 pb-3 sm:mx-0 sm:gap-5 sm:px-0">
        {shots.map((src, i) => (
          <OptimizedImage
            src={src}
            alt={`${appName} screenshot ${i + 1}`}
            width={280}
            height={560}
            class="h-[26rem] w-[11.5rem] shrink-0 rounded-2xl border border-slate-200 bg-white object-cover shadow-md sm:h-[28rem] sm:w-48 dark:border-slate-800"
          />
        ))}
      </div>
    </section>
  )
}
