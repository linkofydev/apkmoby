---
import OptimizedImage from './OptimizedImage.astro';

interface Props {
  appName: string;
  screenshots: string[];
}

const { appName, screenshots } = Astro.props;
---

{
  screenshots.length > 0 && (
    <section aria-labelledby="shots-heading">
      <h2 id="shots-heading" class="mb-4 text-xl font-bold text-slate-900 dark:text-white">
        Screenshots
      </h2>
      <div class="shot-track -mx-4 flex gap-3 overflow-x-auto px-4 pb-2 sm:mx-0 sm:grid sm:grid-cols-3 sm:overflow-visible sm:px-0">
        {screenshots.map((src, i) => (
          <OptimizedImage
            src={src}
            alt={`${appName} screenshot ${i + 1}`}
            width={360}
            height={640}
            class="h-72 w-40 shrink-0 rounded-2xl border border-slate-200 object-cover sm:h-80 sm:w-full dark:border-slate-800"
          />
        ))}
      </div>
    </section>
  )
}
