---
import ListingCard from './ListingCard.astro';
import type { ApkEntry } from '../lib/apk';

interface Props {
  title: string;
  moreHref: string;
  apps: ApkEntry[];
  icon?: 'games' | 'apps';
}

const { title, moreHref, apps, icon = 'apps' } = Astro.props;
---

{
  apps.length > 0 && (
    <section class="space-y-4">
      <div class="flex items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          {icon === 'games' ? (
            <span class="grid h-7 w-7 place-items-center rounded-lg bg-amber-100 text-amber-600" aria-hidden="true">
              ★
            </span>
          ) : (
            <span class="grid h-7 w-7 place-items-center rounded-lg bg-emerald-100 text-emerald-600" aria-hidden="true">
              ❋
            </span>
          )}
          <h2 class="text-xl font-extrabold tracking-tight text-slate-900 sm:text-2xl">{title}</h2>
        </div>
        <a href={moreHref} class="text-sm font-semibold text-emerald-600 hover:underline">
          More
        </a>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {apps.map((app) => (
          <ListingCard app={app} />
        ))}
      </div>
    </section>
  )
}
