---
import OptimizedImage from './OptimizedImage.astro';
import type { ApkEntry } from '../lib/apk';

interface Props {
  app: ApkEntry;
}

const { app } = Astro.props;
const { data } = app;
const featureLine = data.modFeatures.filter(Boolean).join(', ');
---

<a
  href={`/${data.slug}`}
  data-astro-prefetch="hover"
  data-app={`${data.appName} ${data.category} ${featureLine}`}
  class="group flex items-center gap-3 rounded-2xl border border-slate-200/90 bg-white p-3 shadow-sm transition hover:border-amber-400/50 hover:shadow-md"
>
  <OptimizedImage
    src={data.icon}
    alt={`${data.appName} icon`}
    width={72}
    height={72}
    class="h-[4.5rem] w-[4.5rem] shrink-0 rounded-2xl object-cover"
  />
  <div class="min-w-0 flex-1">
    <h3 class="truncate text-[0.95rem] font-bold leading-tight text-slate-900 group-hover:text-slate-950">
      {data.appName}
    </h3>
    <p class="mt-1 truncate text-xs text-slate-500">
      <span class="tabular-nums">{data.ratingValue.toFixed(1)}</span>
      <span class="mx-0.5 text-amber-500" aria-hidden="true">★</span>
      <span class="mx-1 text-slate-300">•</span>
      <span>{data.category}</span>
    </p>
    {
      featureLine ? (
        <p class="mt-1 truncate text-xs font-medium text-amber-700">{featureLine}</p>
      ) : (
        <p class="mt-1 truncate text-xs text-slate-400">v{data.version}</p>
      )
    }
  </div>
</a>
