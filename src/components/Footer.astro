---
import { SITE } from '../config';
---

<footer class="mt-16 border-t border-slate-200 bg-white dark:border-slate-800 dark:bg-ink-raised">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-3">
    <div>
      <p class="font-bold text-slate-900 dark:text-white">{SITE.name}</p>
      <p class="mt-2 max-w-xs text-sm leading-6 text-slate-600 dark:text-slate-400">
        {SITE.tagline}. Only install APKs you trust and have the right to use.
      </p>
    </div>
    <div>
      <p class="text-sm font-semibold text-slate-900 dark:text-white">Explore</p>
      <ul class="mt-3 space-y-2 text-sm text-slate-600 dark:text-slate-400">
        <li><a class="hover:text-cyan-600 dark:hover:text-cyan-300" href="/">Latest APKs</a></li>
        <li><a class="hover:text-cyan-600 dark:hover:text-cyan-300" href="/category/games">Games</a></li>
        <li><a class="hover:text-cyan-600 dark:hover:text-cyan-300" href="/rss.xml">RSS Feed</a></li>
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold text-slate-900 dark:text-white">Legal</p>
      <ul class="mt-3 space-y-2 text-sm text-slate-600 dark:text-slate-400">
        <li><a class="hover:text-cyan-600 dark:hover:text-cyan-300" href="/about">About</a></li>
        <li><a class="hover:text-cyan-600 dark:hover:text-cyan-300" href="/privacy">Privacy Policy</a></li>
        <li><a class="hover:text-cyan-600 dark:hover:text-cyan-300" href="/dmca">DMCA</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-slate-200 py-4 text-center text-xs text-slate-500 dark:border-slate-800">
    © {new Date().getFullYear()} {SITE.name}. All rights reserved.
  </div>
</footer>
