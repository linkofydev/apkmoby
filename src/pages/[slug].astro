---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SchemaAPK from '../components/SchemaAPK.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import StatsTable from '../components/StatsTable.astro';
import Screenshots from '../components/Screenshots.astro';
import TableOfContents from '../components/TableOfContents.astro';
import FAQ from '../components/FAQ.astro';
import RelatedApps from '../components/RelatedApps.astro';
import { categorySlug } from '../config';
import {
  getApks,
  relatedApps,
  resolveFaqs,
  formatDownloads,
  withHeadingIds,
  extractBodyHeadings,
} from '../lib/apk';

export async function getStaticPaths() {
  const apps = await getApks();
  return apps.map((app) => ({
    params: { slug: app.data.slug },
    props: { app, apps },
  }));
}

const { app, apps } = Astro.props;
const { data } = app;
const related = relatedApps(apps, app, 6);
const faqs = resolveFaqs(app);
const catSlug = categorySlug(data.category);
const screenshots = (data.screenshots || []).filter(Boolean);
const summary = (data.summary || '').trim();
const bodyHtml = withHeadingIds(app.body || '');
const bodyHeadings = extractBodyHeadings(bodyHtml);

const tocItems = [
  { id: 'about', label: `About ${data.appName}` },
  ...bodyHeadings,
  ...(data.modFeatures.length > 0 ? [{ id: 'key-features', label: 'Key features' }] : []),
  ...(faqs.length > 0 ? [{ id: 'faqs', label: 'FAQs' }] : []),
];
---

<BaseLayout
  title={data.metaTitle}
  description={data.metaDescription}
  canonical={`/${data.slug}`}
  image={data.featuredImage || data.icon}
  type="article"
  publishedTime={data.publishDate}
  modifiedTime={data.updatedDate}
>
  <Fragment slot="head">
    <SchemaAPK app={app} />
  </Fragment>

  <div class="mx-auto max-w-6xl px-4 py-8">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: data.category, href: `/category/${catSlug}` },
        { label: data.appName },
      ]}
    />

    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6 dark:border-slate-700 dark:bg-ink-card">
      <div class="grid items-start gap-8 lg:grid-cols-[1.2fr_0.8fr]">
        <div class="flex gap-5">
          <OptimizedImage
            src={data.icon}
            alt={`${data.appName} icon`}
            width={96}
            height={96}
            loading="eager"
            fetchpriority="high"
            class="h-24 w-24 rounded-3xl border border-slate-200 shadow-glow dark:border-slate-700"
          />
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
                {data.appName}
              </h1>
              {
                data.modFeatures.length > 0 && (
                  <span class="rounded-full bg-violet-500/15 px-2.5 py-0.5 text-xs font-bold uppercase tracking-wide text-violet-700 dark:text-violet-300">
                    MOD
                  </span>
                )
              }
            </div>
            {
              summary ? (
                <p class="mt-2 max-w-xl text-sm leading-6 text-slate-600 dark:text-slate-300">{summary}</p>
              ) : null
            }
            <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">{data.developer}</p>
            <p class="mt-4 text-sm text-slate-600 dark:text-slate-300">
              ★ {data.ratingValue.toFixed(1)} · {formatDownloads(data.totalDownloads)} downloads · {data.size}
            </p>
            <a
              href={`/download/${data.slug}`}
              data-astro-prefetch="hover"
              class="mt-6 inline-flex rounded-xl bg-cyan-600 px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-cyan-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-600"
            >
              Download Apk Now
            </a>
          </div>
        </div>
        <StatsTable app={app} />
      </div>
    </section>

    <div class="mt-10">
      <Screenshots appName={data.appName} screenshots={screenshots} />
    </div>

    <div class="mt-8 max-w-3xl">
      <TableOfContents items={tocItems} />
    </div>

    <article
      id="about"
      class="prose-apk mx-auto mt-12 max-w-3xl scroll-mt-24 text-left text-slate-700 dark:text-slate-300"
    >
      <h2>About {data.appName}</h2>
      <div set:html={bodyHtml} />
    </article>

    {
      data.modFeatures.length > 0 && (
        <section
          id="key-features"
          class="mx-auto mt-10 max-w-3xl scroll-mt-24 text-left"
          aria-labelledby="features-heading"
        >
          <h2 id="features-heading" class="mb-3 text-xl font-bold">
            Key features
          </h2>
          <ul class="grid gap-2 sm:grid-cols-2">
            {data.modFeatures.map((item) => (
              <li class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm dark:border-slate-800 dark:bg-ink-card">
                {item}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      faqs.length > 0 && (
        <div id="faqs" class="mx-auto mt-10 max-w-3xl scroll-mt-24">
          <FAQ items={faqs} />
        </div>
      )
    }

    <RelatedApps apps={related} />
  </div>
</BaseLayout>
