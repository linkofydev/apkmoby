---
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaAPK from '../components/SchemaAPK.astro';
import ArticleHero from '../components/ArticleHero.astro';
import StatsTable from '../components/StatsTable.astro';
import Screenshots from '../components/Screenshots.astro';
import TableOfContents from '../components/TableOfContents.astro';
import FAQ from '../components/FAQ.astro';
import RelatedApps from '../components/RelatedApps.astro';
import {
  getApks,
  relatedApps,
  resolveFaqs,
  withHeadingIds,
  extractBodyHeadings,
} from '../lib/apk';

export async function getStaticPaths() {
  const apps = await getApks();
  return apps.map((app) => ({
    params: { slug: app.data.slug },
    props: { app, apps },
  }));
}

const { app, apps } = Astro.props;
const { data } = app;
const related = relatedApps(apps, app, 6);
const faqs = resolveFaqs(app);
const screenshots = (data.screenshots || []).filter(Boolean);
const bodyHtml = withHeadingIds(app.body || '');
const bodyHeadings = extractBodyHeadings(bodyHtml);

const tocItems = [
  { id: 'about', label: `About ${data.appName}` },
  ...bodyHeadings,
  ...(data.modFeatures.length > 0 ? [{ id: 'key-features', label: 'Key features' }] : []),
  ...(faqs.length > 0 ? [{ id: 'faqs', label: 'FAQs' }] : []),
];
---

<BaseLayout
  title={data.metaTitle}
  description={data.metaDescription}
  canonical={`/${data.slug}`}
  image={data.featuredImage || data.icon}
  type="article"
  publishedTime={data.publishDate}
  modifiedTime={data.updatedDate}
>
  <Fragment slot="head">
    <SchemaAPK app={app} />
  </Fragment>

  <div class="mx-auto max-w-6xl px-4 py-6 sm:py-8">
    <ArticleHero app={app} />

    <div class="mt-8">
      <StatsTable app={app} />
    </div>

    <div class="mt-10">
      <Screenshots appName={data.appName} screenshots={screenshots} />
    </div>

    <div class="mt-8 max-w-3xl">
      <TableOfContents items={tocItems} />
    </div>

    <article
      id="about"
      class="prose-apk mx-auto mt-12 max-w-3xl scroll-mt-24 text-left text-slate-700 dark:text-slate-300"
    >
      <h2>About {data.appName}</h2>
      <div set:html={bodyHtml} />
    </article>

    {
      data.modFeatures.length > 0 && (
        <section
          id="key-features"
          class="mx-auto mt-10 max-w-3xl scroll-mt-24 text-left"
          aria-labelledby="features-heading"
        >
          <h2 id="features-heading" class="mb-3 text-xl font-bold">
            Key features
          </h2>
          <ul class="grid gap-2 sm:grid-cols-2">
            {data.modFeatures.map((item) => (
              <li class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm dark:border-slate-800 dark:bg-ink-card">
                {item}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      faqs.length > 0 && (
        <div id="faqs" class="mx-auto mt-10 max-w-3xl scroll-mt-24">
          <FAQ items={faqs} />
        </div>
      )
    }

    <RelatedApps apps={related} />
  </div>
</BaseLayout>
