---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
---

<BaseLayout
  title="Privacy Policy"
  description={`Privacy policy for ${SITE.name} (${SITE.url.replace('https://', '')}).`}
  canonical="/privacy"
>
  <div class="prose-apk mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Privacy Policy</h1>
    <p class="mt-4 text-slate-600 dark:text-slate-300">
      {SITE.name} is a static website. We do not create user accounts. Cloudflare may process standard
      request logs (IP address, user agent, and timestamps) for security, caching, and performance.
    </p>
    <p class="text-slate-600 dark:text-slate-300">
      If we add analytics, ads, or comments later, those third parties will have their own privacy terms.
      Questions: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
    </p>
  </div>
</BaseLayout>
