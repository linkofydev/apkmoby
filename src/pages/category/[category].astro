---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AppCard from '../../components/AppCard.astro';
import { categorySlug } from '../../config';
import { getApks, uniqueCategories } from '../../lib/apk';

export async function getStaticPaths() {
  const apps = await getApks();
  const categories = uniqueCategories(apps);
  return categories.map((category) => {
    const slug = categorySlug(category);
    return {
      params: { category: slug },
      props: {
        category,
        apps: apps.filter((app) => categorySlug(app.data.category) === slug),
      },
    };
  });
}

const { category, apps } = Astro.props;
---

<BaseLayout
  title={`${category} APKs`}
  description={`Browse ${apps.length} ${category} Android APK listings with version, size, and MOD details.`}
  canonical={`/category/${categorySlug(category)}`}
>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: category },
      ]}
    />
    <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">{category} APKs</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-400">{apps.length} listings in this category.</p>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {apps.map((app) => <AppCard app={app} />)}
    </div>
  </div>
</BaseLayout>
