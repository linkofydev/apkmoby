---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeShelf from '../components/HomeShelf.astro';
import { SITE, absoluteUrl } from '../config';
import { getApks, splitGamesAndApps } from '../lib/apk';

const apps = await getApks();
const { games, appsOnly } = splitGamesAndApps(apps);
const total = apps.length;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: absoluteUrl('/'),
  description: SITE.description,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${absoluteUrl('/')}?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: absoluteUrl('/'),
  logo: absoluteUrl('/favicon.svg'),
};
---

<BaseLayout
  title={`${SITE.name} — ${SITE.tagline}`}
  description={SITE.description}
  canonical="/"
  image="/images/hero-mod.jpg"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </Fragment>

  <section class="relative isolate overflow-hidden border-b border-slate-200">
    <img
      src="/images/hero-mod.jpg"
      alt=""
      width={1920}
      height={1080}
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-white/78"></div>
    <div class="absolute inset-0 bg-linear-to-r from-white via-white/90 to-cyan-50/40"></div>
    <div class="relative mx-auto flex max-w-6xl flex-col gap-4 px-4 py-12 sm:flex-row sm:items-end sm:justify-between sm:py-16">
      <div class="max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-cyan-700">
          Android MOD library
        </p>
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
          {SITE.name}
        </h1>
        <p class="mt-3 max-w-xl text-sm leading-7 text-slate-700 sm:text-base">
          {SITE.description}
        </p>
      </div>
      {
        total > 0 && (
          <div class="w-full max-w-sm">
            <label class="sr-only" for="moby-find">
              Find an app
            </label>
            <input
              id="moby-find"
              type="search"
              placeholder="Search games & apps…"
              autocomplete="off"
              class="w-full rounded-xl border border-slate-200 bg-white/95 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm outline-none placeholder:text-slate-400 focus:border-cyan-400"
            />
          </div>
        )
      }
    </div>
  </section>

  <div id="library" class="bg-neutral-100 py-10">
    <div class="mx-auto max-w-6xl space-y-10 px-4">
      {
        total > 0 ? (
          <>
            <HomeShelf title="Latest Games" moreHref="/games" apps={games} icon="games" />
            <HomeShelf title="Latest Apps" moreHref="/apps" apps={appsOnly} icon="apps" />
          </>
        ) : (
          <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
            <h2 class="text-xl font-bold text-slate-900">No articles published yet</h2>
            <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-600">
              Published listings will appear here in Latest Games and Latest Apps. Nothing is pre-loaded or hidden.
            </p>
          </div>
        )
      }
    </div>
  </div>

  {
    total > 0 && (
      <script is:inline>
        (function () {
          var input = document.getElementById('moby-find');
          if (!input) return;
          input.addEventListener('input', function () {
            var q = input.value.trim().toLowerCase();
            document.querySelectorAll('[data-app]').forEach(function (el) {
              var hay = (el.getAttribute('data-app') || '').toLowerCase();
              el.classList.toggle('is-dim', q.length > 0 && hay.indexOf(q) === -1);
            });
          });
        })();
      </script>
    )
  }
</BaseLayout>
