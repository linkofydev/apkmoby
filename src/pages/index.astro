---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppCard from '../components/AppCard.astro';
import { SITE, absoluteUrl, categorySlug } from '../config';
import { getApks, uniqueCategories } from '../lib/apk';

const apps = await getApks();
const featured = apps.slice(0, 3);
const latest = apps.slice(0, 9);
const categories = uniqueCategories(apps);

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: absoluteUrl('/'),
  description: SITE.description,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${absoluteUrl('/')}?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: absoluteUrl('/'),
  logo: absoluteUrl('/favicon.svg'),
};
---

<BaseLayout title={`${SITE.name} — ${SITE.tagline}`} description={SITE.description} canonical="/">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </Fragment>

  <section class="border-b border-slate-200 bg-linear-to-b from-cyan-50 to-transparent dark:border-slate-800 dark:from-cyan-950/40">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:py-20">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-700 dark:text-cyan-300">
        Apk Moby
      </p>
      <h1 class="mt-3 max-w-3xl text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl dark:text-white">
        Download Android MOD APKs — Fast, Free & Updated
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-300">
        {SITE.description}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#latest"
          class="rounded-xl bg-linear-to-r from-cyan-400 to-violet-500 px-5 py-3 text-sm font-bold text-ink shadow-glow"
        >
          Browse latest APKs
        </a>
        <a
          href="/admin/"
          class="rounded-xl border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 dark:border-slate-600 dark:text-slate-200"
        >
          Open CMS
        </a>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 py-12">
    <section aria-labelledby="cats-heading" class="mb-12">
      <h2 id="cats-heading" class="mb-4 text-xl font-bold">Categories</h2>
      <div class="flex flex-wrap gap-2">
        {
          categories.map((cat) => (
            <a
              href={`/category/${categorySlug(cat)}`}
              class="rounded-full border border-slate-200 bg-white px-4 py-1.5 text-sm font-medium text-slate-700 hover:border-cyan-400 dark:border-slate-700 dark:bg-ink-card dark:text-slate-200"
            >
              {cat}
            </a>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="featured-heading" class="mb-12">
      <h2 id="featured-heading" class="mb-5 text-xl font-bold">Featured</h2>
      <div class="grid gap-5 md:grid-cols-3">
        {featured.map((app) => <AppCard app={app} />)}
      </div>
    </section>

    <section id="latest" aria-labelledby="latest-heading">
      <h2 id="latest-heading" class="mb-5 text-xl font-bold">Latest APKs</h2>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {latest.map((app) => <AppCard app={app} />)}
      </div>
    </section>
  </div>
</BaseLayout>
