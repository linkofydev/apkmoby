---
import '../../styles/global.css';
import { ADMIN_CATEGORIES } from '../../config';

const categories = [...ADMIN_CATEGORIES];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="bingbot" content="noindex, nofollow, noarchive, nosnippet" />
    <title>Admin Panel</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline src="https://cdn.jsdelivr.net/npm/tinymce@7.6.1/tinymce.min.js" referrerpolicy="origin"></script>
    <style is:global>
      .tox-tinymce { border-radius: 0.75rem !important; border-color: rgba(255,255,255,0.12) !important; }
      /* Light TinyMCE chrome — force dark labels (admin page CSS was washing them out) */
      .tox .tox-toolbar,
      .tox .tox-toolbar__primary,
      .tox .tox-toolbar__overflow,
      .tox .tox-menubar,
      .tox .tox-statusbar {
        background: #f1f5f9 !important;
      }
      .tox .tox-mbtn,
      .tox .tox-mbtn__select-label,
      .tox .tox-tbtn,
      .tox .tox-tbtn__select-label,
      .tox .tox-label,
      .tox .tox-statusbar,
      .tox .tox-statusbar__path-item,
      .tox .tox-listboxfield .tox-listbox--select-label {
        color: #0f172a !important;
      }
      .tox .tox-tbtn svg,
      .tox .tox-mbtn svg,
      .tox .tox-tbtn__icon-wrap svg,
      .tox .tox-collection__item-icon svg {
        fill: #0f172a !important;
      }
      .tox .tox-mbtn:hover:not(:disabled):not(.tox-mbtn--active),
      .tox .tox-tbtn:hover:not(:disabled) {
        background: #e2e8f0 !important;
        color: #0f172a !important;
      }
      .shot-thumb { width: 4.5rem; height: 8rem; object-fit: cover; border-radius: 0.75rem; border: 1px solid rgba(255,255,255,0.12); }
      .preview-icon { width: 4.5rem; height: 4.5rem; object-fit: cover; border-radius: 1rem; border: 1px solid rgba(255,255,255,0.12); }
      .preview-featured { width: 12rem; height: 6.75rem; object-fit: cover; border-radius: 0.75rem; border: 1px solid rgba(255,255,255,0.12); }
    </style>
  </head>
  <body class="min-h-screen bg-ink text-slate-100 antialiased">
    <div id="login-view" class="mx-auto flex min-h-screen max-w-md flex-col justify-center px-4">
      <h1 class="text-2xl font-extrabold">Publisher login</h1>
      <p class="mt-2 text-sm text-slate-400">Private console. Not linked from the public site.</p>
      <form id="login-form" class="mt-8 space-y-4">
        <label class="block text-sm">
          Email
          <input name="email" type="email" required class="mt-1 w-full rounded-xl border border-white/10 bg-ink-card px-3 py-2.5" />
        </label>
        <label class="block text-sm">
          Password
          <input name="password" type="password" required class="mt-1 w-full rounded-xl border border-white/10 bg-ink-card px-3 py-2.5" />
        </label>
        <p id="login-error" class="hidden text-sm text-red-400"></p>
        <button class="w-full rounded-xl bg-cyan-400 py-2.5 text-sm font-bold text-ink">Sign in</button>
      </form>
    </div>

    <div id="app-view" class="hidden">
      <header class="sticky top-0 z-20 border-b border-white/10 bg-ink/90 backdrop-blur">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3">
          <p class="font-bold">Apk Moby · Admin</p>
          <nav class="flex flex-wrap items-center gap-2 text-sm">
            <a href="/admin-panel" class="rounded-lg bg-white/10 px-3 py-1.5 font-medium text-cyan-300">Articles</a>
            <a href="/admin-panel/apk-files" class="rounded-lg border border-white/15 px-3 py-1.5 text-slate-300 hover:text-white">APK Files</a>
            <a href="/admin-panel/social-settings" class="rounded-lg border border-white/15 px-3 py-1.5 text-slate-300 hover:text-white">Social Settings</a>
            <button id="btn-new" type="button" class="rounded-lg bg-cyan-400 px-3 py-1.5 text-sm font-bold text-ink">New APK</button>
            <button id="btn-logout" type="button" class="rounded-lg border border-white/15 px-3 py-1.5 text-sm">Logout</button>
          </nav>
        </div>
      </header>

      <main class="mx-auto max-w-6xl px-4 py-8">
        <section id="list-panel">
          <div class="mb-4 flex items-center justify-between gap-3">
            <h2 class="text-xl font-bold">All listings</h2>
            <input id="list-search" type="search" placeholder="Search…" class="w-56 rounded-lg border border-white/10 bg-ink-card px-3 py-2 text-sm" />
          </div>
          <div id="list" class="overflow-hidden rounded-2xl border border-white/10"></div>
        </section>

        <section id="editor-panel" class="hidden">
          <button id="btn-back" type="button" class="mb-4 text-sm text-cyan-300">← Back to list</button>
          <form id="editor" class="grid gap-4 md:grid-cols-2">
            <input type="hidden" name="sha" />
            <label class="text-sm">App name<input name="appName" required class="mt-1 w-full rounded-lg border border-white/10 bg-ink-card px-3 py-2" /></label>
            <label class="text-sm md:col-span-2">
              Slug / page URL
              <div class="mt-1 flex overflow-hidden rounded-lg border border-white/10">
                <span class="shrink-0 bg-white/5 px-3 py-2 text-sm text-slate-400">https://apkmoby.com/</span>
                <input name="slug" required placeholder="clash-of-clans-mod" class="min-w-0 flex-1 bg-ink-card px-3 py-2 outline-none" />
              </div>
              <p class="mt-1 text-xs text-slate-500">SEO slug only — type the keyword part after the domain.</p>
            </label>
            <label class="text-sm md:col-span-2">Title<input name="title" required class="mt-1 w-full rounded-lg border border-white/10 bg-ink-card px-3 py-2" /></label>
            <label class="text-sm md:col-span-2">Meta title<input name="metaTitle" required class="mt-1 w-full rounded-lg border border-white/10 bg-ink-card px-3 py-2" /></label>
            <label class="text-sm md:col-span-2">Meta description<textarea name="metaDescription" required rows="2" class="mt-1 w-full rounded-lg border border-white/10 bg-ink-card px-3 py-2"></textarea></label>
            <label class="text-sm md:col-span-2">
              Hero summary (2–3 sentences)
              <textarea name="summary" rows="3" maxlength="400" placeholder="Short summary shown under the H1 in the article hero box." class="mt-1 w-full rounded-lg border border-white/10 bg-ink-card px-3 py-2"></textarea>
              <p class="mt-1 text-xs text-slate-500">Appears directly under the app name in the bordered hero section.</p>
            </label>
            <label class="text-sm">Category
              <select name="category" class="mt-1 w-full rounded-lg border border-white/10 bg-ink-card px-3 py-2">
                {categories.map((c) => <option value={c}>{c}</option>)}
              </select>
            </label>
            <label class="text-sm">Version<input name="version" required class="mt-1 w-full rounded-lg border border-white/10 bg-ink-card px-3 py-2" /></label>
            <label class="text-sm">Size<input name="size" required placeholder="84 MB" class="mt-1 w-full rounded-lg border border-white/10 bg-ink-card px-3 py-2" /></label>
            <label class="text-sm">Developer<input name="developer" required class="mt-1 w-full rounded-lg border border-white/10 bg-ink-card px-3 py-2" /></label>
            <label class="text-sm">Package name<input name="packageName" required class="mt-1 w-full rounded-lg border border-white/10 bg-ink-card px-3 py-2" /></label>
            <label class="text-sm">Required Android<input name="reqAndroid" required placeholder="8.0+" class="mt-1 w-full rounded-lg border border-white/10 bg-ink-card px-3 py-2" /></label>
            <label class="text-sm">Downloads<input name="totalDownloads" class="mt-1 w-full rounded-lg border border-white/10 bg-ink-card px-3 py-2" /></label>
            <label class="text-sm">Rating (1–5)<input name="ratingValue" type="number" min="1" max="5" step="0.1" class="mt-1 w-full rounded-lg border border-white/10 bg-ink-card px-3 py-2" /></label>
            <label class="text-sm">Rating count<input name="ratingCount" type="number" min="0" class="mt-1 w-full rounded-lg border border-white/10 bg-ink-card px-3 py-2" /></label>
            <label class="text-sm">Publish date<input name="publishDate" type="date" class="mt-1 w-full rounded-lg border border-white/10 bg-ink-card px-3 py-2" /></label>
            <label class="text-sm">Updated date<input name="updatedDate" type="date" class="mt-1 w-full rounded-lg border border-white/10 bg-ink-card px-3 py-2" /></label>
            <label class="text-sm md:col-span-2">Download URL<input name="downloadUrl" required class="mt-1 w-full rounded-lg border border-white/10 bg-ink-card px-3 py-2" /></label>

            <div class="md:col-span-2 rounded-xl border border-white/10 p-4">
              <p class="text-sm font-medium">Icon URL</p>
              <p class="mt-1 text-xs text-slate-400">Required size: <strong class="text-slate-200">512×512 px</strong> square (PNG or WebP). Max 5MB. Shown at ~72×72 on the homepage.</p>
              <div class="mt-3 flex flex-wrap items-start gap-3">
                <input name="icon" class="min-w-[14rem] flex-1 rounded-lg border border-white/10 bg-ink-card px-3 py-2 text-sm" placeholder="/uploads/icon.png" />
                <button type="button" id="btn-icon-upload" class="rounded-lg border border-white/15 px-3 py-2 text-sm">Upload from PC</button>
                <input id="icon-file" type="file" accept="image/*" class="hidden" />
                <img id="icon-preview" alt="" class="preview-icon hidden" />
              </div>
              <p id="icon-status" class="mt-2 text-xs text-slate-400"></p>
            </div>

            <div class="md:col-span-2 rounded-xl border border-white/10 p-4">
              <p class="text-sm font-medium">Featured image URL</p>
              <p class="mt-1 text-xs text-slate-400">Required size: <strong class="text-slate-200">1280×720 px</strong> (16:9) PNG/JPG/WebP. Max 5MB. Used for cover and social share.</p>
              <div class="mt-3 flex flex-wrap items-start gap-3">
                <input name="featuredImage" class="min-w-[14rem] flex-1 rounded-lg border border-white/10 bg-ink-card px-3 py-2 text-sm" placeholder="/uploads/cover.jpg" />
                <button type="button" id="btn-featured-upload" class="rounded-lg border border-white/15 px-3 py-2 text-sm">Upload from PC</button>
                <input id="featured-file" type="file" accept="image/*" class="hidden" />
                <img id="featured-preview" alt="" class="preview-featured hidden" />
              </div>
              <p id="featured-status" class="mt-2 text-xs text-slate-400"></p>
            </div>

            <div class="md:col-span-2 rounded-xl border border-white/10 p-4">
              <p class="text-sm font-medium">MOD features</p>
              <p class="mt-1 mb-3 text-xs text-slate-400">Use the toolbar for headings, bold, lists, and links. Homepage cards show the plain-text summary.</p>
              <textarea id="mod-html" name="modHtml" rows="6" class="w-full rounded-lg border border-white/10 bg-ink-card px-3 py-2 text-sm"></textarea>
            </div>

            <div class="md:col-span-2 rounded-xl border border-white/10 p-4">
              <p class="text-sm font-medium">Screenshots</p>
              <p class="mt-1 text-xs text-slate-400">Recommended: <strong class="text-slate-200">1080×1920</strong> (9:16 phone) or <strong class="text-slate-200">1280×720</strong>. Max 5MB each. Upload first, then click <strong class="text-slate-200">Save / Publish</strong> so the article and images go live together.</p>
              <div class="mt-3 flex flex-wrap gap-2">
                <button type="button" id="btn-shot-upload" class="rounded-lg border border-white/15 px-3 py-2 text-sm">Upload from PC</button>
                <button type="button" id="btn-shot-url" class="rounded-lg border border-white/15 px-3 py-2 text-sm">Add image URL</button>
                <input id="shot-file" type="file" accept="image/*" multiple class="hidden" />
              </div>
              <div id="shot-previews" class="mt-3 flex flex-wrap gap-2"></div>
              <textarea name="screenshots" rows="3" class="mt-3 w-full rounded-lg border border-white/10 bg-ink-card px-3 py-2 text-sm" placeholder="One image URL per line"></textarea>
              <p id="shot-status" class="mt-2 text-xs text-slate-400"></p>
            </div>

            <div class="md:col-span-2 rounded-xl border border-white/10 p-4">
              <p class="text-sm font-medium">Body / description</p>
              <p class="mt-1 mb-3 text-xs text-slate-400">Full article editor: headings, bold/italic, bullets, numbered lists, links, tables, and images.</p>
              <textarea id="body-html" name="body" rows="12" class="w-full rounded-lg border border-white/10 bg-ink-card px-3 py-2 text-sm"></textarea>
            </div>

            <div class="md:col-span-2 rounded-xl border border-white/10 p-4">
              <div class="mb-3 flex items-center justify-between gap-3">
                <div>
                  <p class="text-sm font-medium">FAQs (research based)</p>
                  <p class="mt-1 text-xs text-slate-400">No limit — add as many Q&amp;A pairs as you want. Empty list uses default template FAQs.</p>
                </div>
                <button type="button" id="btn-faq-add" class="rounded-lg border border-white/15 px-3 py-2 text-sm">Add FAQ</button>
              </div>
              <div id="faq-list" class="space-y-3"></div>
            </div>

            <p id="editor-error" class="hidden md:col-span-2 text-sm text-red-400"></p>
            <p id="editor-success" class="hidden md:col-span-2 text-sm text-emerald-300"></p>
            <div class="md:col-span-2 flex flex-wrap gap-3">
              <button id="btn-save" type="submit" class="rounded-xl bg-cyan-400 px-5 py-2.5 text-sm font-bold text-ink">Save / Publish</button>
              <button id="btn-draft" type="button" class="rounded-xl border border-amber-400/40 px-5 py-2.5 text-sm font-semibold text-amber-200">Save Draft</button>
              <button id="btn-duplicate" type="button" class="rounded-xl border border-white/15 px-5 py-2.5 text-sm">Duplicate</button>
              <button id="btn-delete" type="button" class="rounded-xl border border-red-400/40 px-5 py-2.5 text-sm text-red-300">Delete</button>
            </div>
            <p class="md:col-span-2 text-xs text-slate-500">Save Draft keeps incomplete work in the admin list (not live). Save / Publish makes it public on apkmoby.com.</p>
          </form>
        </section>
      </main>
    </div>

    <div id="reauth-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4" role="dialog" aria-modal="true" aria-labelledby="reauth-title">
      <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-ink-card p-5 shadow-xl">
        <h3 id="reauth-title" class="text-lg font-bold">Confirm with password</h3>
        <p id="reauth-desc" class="mt-2 text-sm text-slate-400">Enter your admin password to continue.</p>
        <form id="reauth-form" class="mt-4 space-y-3">
          <label class="block text-sm">
            Password
            <input id="reauth-password" name="password" type="password" required autocomplete="current-password" class="mt-1 w-full rounded-xl border border-white/10 bg-ink px-3 py-2.5" />
          </label>
          <p id="reauth-error" class="hidden text-sm text-red-400"></p>
          <div class="flex gap-2 pt-1">
            <button type="submit" class="flex-1 rounded-xl bg-cyan-400 py-2.5 text-sm font-bold text-ink">Confirm</button>
            <button type="button" id="reauth-cancel" class="flex-1 rounded-xl border border-white/15 py-2.5 text-sm">Cancel</button>
          </div>
        </form>
      </div>
    </div>

    <div id="share-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4" role="dialog" aria-modal="true" aria-labelledby="share-title">
      <div class="w-full max-w-lg rounded-2xl border border-white/10 bg-ink-card p-5 shadow-xl">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h3 id="share-title" class="text-lg font-bold">Browser Share</h3>
            <p id="share-article" class="mt-1 text-sm text-slate-400">Open a platform — link &amp; text are prefilled. Then click Share.</p>
          </div>
          <button type="button" id="share-close" class="rounded-lg border border-white/15 px-2.5 py-1 text-sm">Close</button>
        </div>
        <p id="share-url" class="mt-3 break-all rounded-lg border border-white/10 bg-ink px-3 py-2 text-xs text-cyan-200"></p>
        <p id="share-hint" class="mt-2 hidden text-xs text-amber-200"></p>
        <div class="mt-4">
          <div class="mb-2 flex items-center justify-between gap-2">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Share platforms</p>
            <button type="button" id="share-toggle-all" class="text-xs font-semibold text-pink-300 hover:text-pink-200">Show All</button>
          </div>
          <div id="share-composers" class="grid grid-cols-2 gap-2 sm:grid-cols-3"></div>
        </div>
        <div class="mt-4 flex flex-wrap gap-2">
          <button type="button" id="share-copy" class="rounded-xl border border-white/15 px-4 py-2.5 text-sm hover:bg-white/5">Copy link</button>
          <button type="button" id="share-open-all" class="flex-1 rounded-xl bg-cyan-400 px-4 py-2.5 text-sm font-bold text-ink">Open All Tabs</button>
        </div>
        <p class="mt-2 text-xs text-slate-500">Allow popups for this site. Each button opens that network’s share page with your article ready.</p>
      </div>
    </div>

    <script is:inline>
      const loginView = document.getElementById('login-view');
      const appView = document.getElementById('app-view');
      const listPanel = document.getElementById('list-panel');
      const editorPanel = document.getElementById('editor-panel');
      const listEl = document.getElementById('list');
      const form = document.getElementById('editor');
      const reauthModal = document.getElementById('reauth-modal');
      const reauthForm = document.getElementById('reauth-form');
      const reauthPassword = document.getElementById('reauth-password');
      const reauthError = document.getElementById('reauth-error');
      const reauthDesc = document.getElementById('reauth-desc');
      const shareModal = document.getElementById('share-modal');
      const shareArticleEl = document.getElementById('share-article');
      const shareUrlEl = document.getElementById('share-url');
      const shareHintEl = document.getElementById('share-hint');
      const shareComposersEl = document.getElementById('share-composers');
      const shareToggleAllBtn = document.getElementById('share-toggle-all');
      let mode = 'create';
      let currentSlug = '';
      let rows = [];
      let editorsReady = false;
      let adminEmail = '';
      let reauthResolver = null;
      let sharePayload = null;
      let shareTargets = [];
      let shareShowAll = false;
      const SHARE_PREVIEW_COUNT = 6;

      const today = () => new Date().toISOString().slice(0, 10);
      const slugify = (v) => v.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      const show = (el, on) => el.classList.toggle('hidden', !on);
      const setError = (id, msg) => {
        const n = document.getElementById(id);
        n.textContent = msg || '';
        show(n, !!msg);
      };

      function closeReauth(ok) {
        show(reauthModal, false);
        reauthModal.classList.remove('flex');
        reauthModal.classList.add('hidden');
        reauthPassword.value = '';
        setError('reauth-error', '');
        const resolve = reauthResolver;
        reauthResolver = null;
        if (resolve) resolve(!!ok);
      }

      function requireAdminPassword(actionLabel) {
        return new Promise((resolve) => {
          if (!adminEmail) {
            alert('Session expired. Please log in again.');
            resolve(false);
            return;
          }
          reauthResolver = resolve;
          reauthDesc.textContent = 'Enter your admin password to ' + actionLabel + '.';
          setError('reauth-error', '');
          reauthPassword.value = '';
          reauthModal.classList.remove('hidden');
          reauthModal.classList.add('flex');
          setTimeout(() => reauthPassword.focus(), 50);
        });
      }

      reauthForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        setError('reauth-error', '');
        const password = reauthPassword.value;
        if (!password) {
          setError('reauth-error', 'Password is required');
          return;
        }
        try {
          await api('/api/admin/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: adminEmail, password }),
          });
          closeReauth(true);
        } catch (err) {
          setError('reauth-error', err.message || 'Invalid password');
        }
      });
      document.getElementById('reauth-cancel').addEventListener('click', () => closeReauth(false));
      reauthModal.addEventListener('click', (e) => {
        if (e.target === reauthModal) closeReauth(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !reauthModal.classList.contains('hidden')) closeReauth(false);
        if (e.key === 'Escape' && !shareModal.classList.contains('hidden')) closeShareModal();
      });

      function absolutePublicUrl(path) {
        if (!path) return '';
        if (/^https?:\/\//i.test(path)) return path;
        return 'https://apkmoby.com' + (path.startsWith('/') ? path : '/' + path);
      }

      function buildComposerTargets(article) {
        const title = encodeURIComponent(article.title || article.appName || '');
        const url = encodeURIComponent(article.url);
        const image = encodeURIComponent(article.image || '');
        const text = encodeURIComponent((article.title || '') + ' ' + article.url);
        return [
          { id: 'facebook', label: 'Facebook', href: 'https://www.facebook.com/sharer/sharer.php?u=' + url },
          { id: 'twitter', label: 'Twitter / X', href: 'https://twitter.com/intent/tweet?url=' + url + '&text=' + title },
          { id: 'telegram', label: 'Telegram', href: 'https://t.me/share/url?url=' + url + '&text=' + title },
          { id: 'whatsapp', label: 'WhatsApp', href: 'https://api.whatsapp.com/send?text=' + text },
          { id: 'linkedin', label: 'LinkedIn', href: 'https://www.linkedin.com/sharing/share-offsite/?url=' + url },
          { id: 'pinterest', label: 'Pinterest', href: 'https://pinterest.com/pin/create/button/?url=' + url + '&media=' + image + '&description=' + title },
          { id: 'reddit', label: 'Reddit', href: 'https://www.reddit.com/submit?url=' + url + '&title=' + title },
          { id: 'tumblr', label: 'Tumblr', href: 'https://www.tumblr.com/widgets/share/tool?canonicalUrl=' + url + '&title=' + title + '&caption=' + title },
          { id: 'vk', label: 'VK', href: 'https://vk.com/share.php?url=' + url + '&title=' + title },
          { id: 'line', label: 'Line', href: 'https://social-plugins.line.me/lineit/share?url=' + url },
          { id: 'threads', label: 'Threads', href: 'https://www.threads.net/intent/post?text=' + text },
          { id: 'email', label: 'Email', href: 'mailto:?subject=' + title + '&body=' + text },
          { id: 'sms', label: 'SMS', href: 'sms:?&body=' + text },
          { id: 'buffer', label: 'Buffer', href: 'https://buffer.com/add?text=' + title + '&url=' + url },
          { id: 'hackernews', label: 'Hacker News', href: 'https://news.ycombinator.com/submitlink?u=' + url + '&t=' + title },
          { id: 'bluesky', label: 'Bluesky', href: 'https://bsky.app/intent/compose?text=' + text },
        ];
      }

      function escapeShareHtml(s) {
        return String(s || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function renderShareButtons() {
        if (!sharePayload) return;
        shareTargets = buildComposerTargets(sharePayload);
        const visible = shareShowAll ? shareTargets : shareTargets.slice(0, SHARE_PREVIEW_COUNT);
        shareComposersEl.innerHTML = visible
          .map(
            (t) =>
              '<button type="button" data-share-id="' +
              escapeShareHtml(t.id) +
              '" class="rounded-xl border border-white/15 px-3 py-2.5 text-sm hover:bg-white/5">' +
              escapeShareHtml(t.label) +
              '</button>',
          )
          .join('');
        shareToggleAllBtn.textContent = shareShowAll ? 'Show Less' : 'Show All';
        shareToggleAllBtn.classList.toggle('hidden', shareTargets.length <= SHARE_PREVIEW_COUNT);
      }

      async function copyShareText() {
        if (!sharePayload) return false;
        const text = (sharePayload.title || '') + '\n' + sharePayload.url;
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          try {
            const ta = document.createElement('textarea');
            ta.value = text;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            ta.remove();
            return true;
          } catch {
            return false;
          }
        }
      }

      function openShareTab(href) {
        const win = window.open(href, '_blank');
        if (win) {
          try {
            win.opener = null;
          } catch {}
        }
        return !!win;
      }

      function closeShareModal() {
        shareModal.classList.add('hidden');
        shareModal.classList.remove('flex');
        sharePayload = null;
        shareTargets = [];
        shareShowAll = false;
        shareHintEl.classList.add('hidden');
        shareHintEl.textContent = '';
      }

      async function openShareModal(row) {
        let featuredImage = row.featuredImage || '';
        let icon = row.icon || '';
        let title = row.title || row.appName || row.slug;
        try {
          const entry = await api('/api/admin/apps/' + row.slug);
          featuredImage = entry.data?.featuredImage || featuredImage;
          icon = entry.data?.icon || icon;
          title = entry.data?.title || entry.data?.appName || title;
        } catch {}
        const url = 'https://apkmoby.com/' + row.slug;
        sharePayload = {
          title,
          appName: row.appName || '',
          slug: row.slug,
          url,
          image: absolutePublicUrl(featuredImage || icon || ''),
        };
        shareArticleEl.textContent = sharePayload.title;
        shareUrlEl.textContent = url;
        shareHintEl.classList.add('hidden');
        shareShowAll = false;
        renderShareButtons();
        shareModal.classList.remove('hidden');
        shareModal.classList.add('flex');
      }

      document.getElementById('share-close').addEventListener('click', closeShareModal);
      shareModal.addEventListener('click', (e) => {
        if (e.target === shareModal) closeShareModal();
      });
      shareToggleAllBtn.addEventListener('click', () => {
        shareShowAll = !shareShowAll;
        renderShareButtons();
      });
      shareModal.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-share-id]');
        if (!btn || !sharePayload) return;
        const target = shareTargets.find((t) => t.id === btn.getAttribute('data-share-id'));
        if (!target) return;
        const ok = openShareTab(target.href);
        if (!ok) {
          shareHintEl.textContent = 'Popup blocked. Allow popups for this site, then try again.';
          shareHintEl.classList.remove('hidden');
        }
      });
      document.getElementById('share-copy').addEventListener('click', async () => {
        const ok = await copyShareText();
        shareHintEl.textContent = ok ? 'Article link copied to clipboard.' : 'Could not copy — select the URL above manually.';
        shareHintEl.classList.remove('hidden');
      });
      document.getElementById('share-open-all').addEventListener('click', async () => {
        if (!sharePayload) return;
        shareShowAll = true;
        renderShareButtons();
        await copyShareText();
        let opened = 0;
        let blocked = 0;
        for (let i = 0; i < shareTargets.length; i++) {
          await new Promise((r) => setTimeout(r, i === 0 ? 0 : 450));
          if (openShareTab(shareTargets[i].href)) opened += 1;
          else blocked += 1;
        }
        shareHintEl.textContent = blocked
          ? 'Opened ' + opened + '/' + shareTargets.length + '. Allow popups, then click Open All Tabs again.'
          : 'Opened ' + opened + ' share tabs with your article prefilled.';
        shareHintEl.classList.remove('hidden');
      });

      function normalizeSlug(v) {
        return String(v || '')
          .trim()
          .replace(/^https?:\/\/(www\.)?apkmoby\.com\/?/i, '')
          .replace(/^\/+/, '')
          .split(/[?#]/)[0]
          .replace(/\/+$/, '');
      }

      async function api(url, opts) {
        const res = await fetch(url, { credentials: 'same-origin', ...opts });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'Request failed');
        return data;
      }

      async function uploadFile(file, statusEl) {
        if (statusEl) statusEl.textContent = 'Uploading…';
        const fd = new FormData();
        fd.append('file', file);
        const data = await api('/api/admin/upload', { method: 'POST', body: fd });
        if (statusEl) statusEl.textContent = 'Uploaded: ' + data.url;
        return data.url;
      }

      function featuresToHtml(list) {
        if (!list || !list.length) return '';
        return '<ul>' + list.map((f) => '<li>' + String(f).replace(/</g, '&lt;') + '</li>').join('') + '</ul>';
      }

      function htmlToFeatures(html) {
        const tmp = document.createElement('div');
        tmp.innerHTML = html || '';
        const lis = [...tmp.querySelectorAll('li')].map((li) => li.textContent.trim()).filter(Boolean);
        if (lis.length) return lis;
        return (tmp.innerText || '')
          .split(/\n|,/)
          .map((s) => s.trim())
          .filter(Boolean);
      }

      function shotList() {
        return String(form.screenshots.value || '')
          .split('\n')
          .map((s) => s.trim())
          .filter(Boolean);
      }

      function setShots(urls) {
        form.screenshots.value = urls.join('\n');
        renderShotPreviews();
      }

      function renderShotPreviews() {
        const box = document.getElementById('shot-previews');
        const urls = shotList();
        box.innerHTML = urls
          .map(
            (u, i) =>
              '<div class="relative">' +
              '<img class="shot-thumb" src="' +
              u +
              '" alt="Screenshot ' +
              (i + 1) +
              '" />' +
              '<button type="button" data-shot-del="' +
              i +
              '" class="absolute -right-1 -top-1 rounded-full bg-red-500 px-1.5 text-xs">×</button></div>',
          )
          .join('');
      }

      function updateMediaPreviews() {
        const icon = form.icon.value.trim();
        const featured = form.featuredImage.value.trim();
        const iconPrev = document.getElementById('icon-preview');
        const featPrev = document.getElementById('featured-preview');
        if (icon) {
          iconPrev.src = icon;
          show(iconPrev, true);
        } else show(iconPrev, false);
        if (featured) {
          featPrev.src = featured;
          show(featPrev, true);
        } else show(featPrev, false);
      }

      async function imageUploadHandler(blobInfo) {
        const fd = new FormData();
        fd.append('file', blobInfo.blob(), blobInfo.filename());
        const data = await api('/api/admin/upload', { method: 'POST', body: fd });
        return data.url;
      }

      async function ensureEditors() {
        if (editorsReady || typeof tinymce === 'undefined') return;
        await tinymce.init({
          selector: '#mod-html',
          base_url: 'https://cdn.jsdelivr.net/npm/tinymce@7.6.1',
          suffix: '.min',
          menubar: false,
          branding: false,
          promotion: false,
          height: 220,
          content_style:
            'body{font-family:system-ui,sans-serif;font-size:14px;color:#0f172a;background:#fff;padding:8px}',
          plugins: 'lists link autolink',
          toolbar: 'styles | bold italic underline | bullist numlist | link | removeformat',
          relative_urls: false,
          convert_urls: false,
        });
        await tinymce.init({
          selector: '#body-html',
          base_url: 'https://cdn.jsdelivr.net/npm/tinymce@7.6.1',
          suffix: '.min',
          menubar: 'edit insert format table',
          branding: false,
          promotion: false,
          height: 420,
          content_style:
            'body{font-family:system-ui,sans-serif;font-size:15px;line-height:1.6;color:#0f172a;background:#fff;padding:12px} table{border-collapse:collapse;width:100%} td,th{border:1px solid #cbd5e1;padding:6px 8px}',
          plugins: 'lists link table image code fullscreen autolink',
          toolbar:
            'undo redo | styles | bold italic underline | alignleft aligncenter alignright | bullist numlist | link table image | code removeformat',
          images_upload_handler: imageUploadHandler,
          relative_urls: false,
          convert_urls: false,
        });
        editorsReady = true;
      }

      function setEditorContent(id, html) {
        const ed = typeof tinymce !== 'undefined' ? tinymce.get(id) : null;
        if (ed) ed.setContent(html || '');
        else {
          const el = document.getElementById(id);
          if (el) el.value = html || '';
        }
      }

      function getEditorContent(id) {
        const ed = typeof tinymce !== 'undefined' ? tinymce.get(id) : null;
        if (ed) return ed.getContent();
        const el = document.getElementById(id);
        return el ? el.value : '';
      }

      function readFaqs() {
        return [...document.querySelectorAll('#faq-list .faq-row')]
          .map((row) => ({
            q: (row.querySelector('[data-faq="q"]')?.value || '').trim(),
            a: (row.querySelector('[data-faq="a"]')?.value || '').trim(),
          }))
          .filter((item) => item.q && item.a);
      }

      function addFaqRow(item) {
        const box = document.getElementById('faq-list');
        const row = document.createElement('div');
        row.className = 'faq-row rounded-lg border border-white/10 p-3';
        row.innerHTML =
          '<label class="block text-xs text-slate-400">Question<input data-faq="q" class="mt-1 w-full rounded-lg border border-white/10 bg-ink-card px-3 py-2 text-sm" /></label>' +
          '<label class="mt-2 block text-xs text-slate-400">Answer<textarea data-faq="a" rows="2" class="mt-1 w-full rounded-lg border border-white/10 bg-ink-card px-3 py-2 text-sm"></textarea></label>' +
          '<button type="button" data-faq-del class="mt-2 text-xs text-red-300">Remove</button>';
        if (item) {
          row.querySelector('[data-faq="q"]').value = item.q || '';
          row.querySelector('[data-faq="a"]').value = item.a || '';
        }
        box.appendChild(row);
      }

      function setFaqs(list) {
        const box = document.getElementById('faq-list');
        box.innerHTML = '';
        const items = Array.isArray(list) ? list.filter((item) => item && (item.q || item.a)) : [];
        if (!items.length) return;
        items.forEach((item) => addFaqRow(item));
      }

      function emptyPayload() {
        return {
          title: '',
          metaTitle: '',
          metaDescription: '',
          summary: '',
          appName: '',
          slug: '',
          icon: '',
          category: 'Games',
          version: '',
          size: '',
          developer: '',
          packageName: '',
          reqAndroid: '',
          totalDownloads: '',
          ratingValue: 4.5,
          ratingCount: 0,
          modFeatures: [],
          modHtml: '',
          faqs: [],
          downloadUrl: '',
          publishDate: today(),
          updatedDate: today(),
          featuredImage: '',
          screenshots: [],
          body: '',
          draft: false,
          sha: '',
        };
      }

      async function fillForm(p) {
        await ensureEditors();
        form.sha.value = p.sha || '';
        form.appName.value = p.appName || '';
        form.slug.value = normalizeSlug(p.slug || '');
        form.title.value = p.title || '';
        form.metaTitle.value = p.metaTitle || '';
        form.metaDescription.value = p.metaDescription || '';
        form.summary.value = p.summary || '';
        form.category.value = p.category || 'Games';
        form.version.value = p.version || '';
        form.size.value = p.size || '';
        form.developer.value = p.developer || '';
        form.packageName.value = p.packageName || '';
        form.reqAndroid.value = p.reqAndroid || '';
        form.totalDownloads.value = p.totalDownloads || '';
        form.ratingValue.value = p.ratingValue || 4.5;
        form.ratingCount.value = p.ratingCount || 0;
        form.publishDate.value = (p.publishDate || today()).toString().slice(0, 10);
        form.updatedDate.value = (p.updatedDate || today()).toString().slice(0, 10);
        form.downloadUrl.value = p.downloadUrl || '';
        form.icon.value = p.icon || '';
        form.featuredImage.value = p.featuredImage || '';
        form.dataset.draft = p.draft ? '1' : '0';
        const features = Array.isArray(p.modFeatures) ? p.modFeatures : [];
        setEditorContent('mod-html', p.modHtml || featuresToHtml(features));
        setShots(Array.isArray(p.screenshots) ? p.screenshots : []);
        setEditorContent('body-html', p.body || '');
        setFaqs(Array.isArray(p.faqs) ? p.faqs : []);
        updateMediaPreviews();
      }

      function readForm(asDraft) {
        const slug = normalizeSlug(form.slug.value);
        const modHtml = getEditorContent('mod-html');
        return {
          sha: form.sha.value || '',
          title: form.title.value || '',
          metaTitle: form.metaTitle.value || '',
          metaDescription: form.metaDescription.value || '',
          summary: form.summary.value || '',
          appName: form.appName.value || '',
          slug,
          icon: form.icon.value || '',
          category: form.category.value || 'Games',
          version: form.version.value || '',
          size: form.size.value || '',
          developer: form.developer.value || '',
          packageName: form.packageName.value || '',
          reqAndroid: form.reqAndroid.value || '',
          totalDownloads: form.totalDownloads.value || '',
          ratingValue: Number(form.ratingValue.value || 0),
          ratingCount: Number(form.ratingCount.value || 0),
          modFeatures: htmlToFeatures(modHtml),
          modHtml,
          faqs: readFaqs(),
          downloadUrl: form.downloadUrl.value || '',
          publishDate: form.publishDate.value || today(),
          updatedDate: today(),
          featuredImage: form.featuredImage.value || '',
          screenshots: shotList(),
          body: getEditorContent('body-html'),
          draft: !!asDraft,
        };
      }

      function renderList(filter) {
        const q = (filter || '').toLowerCase();
        const items = rows.filter((r) => (r.appName + r.category + r.slug + (r.draft ? ' draft' : '')).toLowerCase().includes(q));
        if (!items.length) {
          listEl.innerHTML = '<p class="p-6 text-sm text-slate-400">No listings yet. Click New APK.</p>';
          return;
        }
        listEl.innerHTML =
          '<table class="w-full text-sm"><thead class="bg-white/5 text-left text-slate-400"><tr><th class="px-4 py-3">App</th><th>Status</th><th>Category</th><th>Version</th><th>Updated</th><th></th></tr></thead><tbody>' +
          items
            .map((r) => {
              const status = r.draft
                ? '<span class="rounded-full border border-amber-400/40 bg-amber-500/10 px-2 py-0.5 text-xs font-semibold text-amber-200">Draft</span>'
                : '<span class="rounded-full border border-emerald-400/40 bg-emerald-500/10 px-2 py-0.5 text-xs font-semibold text-emerald-300">Published</span>';
              const shareBtn = r.draft
                ? ''
                : '<button type="button" data-share-slug="' +
                  r.slug +
                  '" class="text-amber-300">Share</button>';
              return (
                '<tr class="border-t border-white/10"><td class="px-4 py-3 font-medium">' +
                r.appName +
                '</td><td class="px-4 py-3">' +
                status +
                '</td><td>' +
                r.category +
                '</td><td>' +
                r.version +
                '</td><td>' +
                (r.updatedDate || '') +
                '</td><td class="px-4 py-3 text-right whitespace-nowrap space-x-2">' +
                shareBtn +
                '<button type="button" data-edit="' +
                r.slug +
                '" class="text-cyan-300">Edit</button><button type="button" data-del="' +
                r.slug +
                '" data-sha="' +
                r.sha +
                '" class="text-red-300">Delete</button></td></tr>'
              );
            })
            .join('') +
          '</tbody></table>';
      }

      async function loadList() {
        const data = await api('/api/admin/apps');
        rows = data.apps || [];
        renderList(document.getElementById('list-search').value);
      }

      async function openEditor(isNew) {
        mode = isNew ? 'create' : 'edit';
        show(listPanel, false);
        show(editorPanel, true);
        setError('editor-error', '');
        await ensureEditors();
      }

      document.getElementById('login-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        setError('login-error', '');
        const fd = new FormData(e.target);
        try {
          const email = String(fd.get('email') || '').trim().toLowerCase();
          await api('/api/admin/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password: fd.get('password') }),
          });
          adminEmail = email;
          show(loginView, false);
          show(appView, true);
          await loadList();
        } catch (err) {
          setError('login-error', err.message);
        }
      });

      document.getElementById('btn-logout').addEventListener('click', async () => {
        await api('/api/admin/logout', { method: 'POST' });
        location.reload();
      });

      document.getElementById('btn-new').addEventListener('click', async () => {
        currentSlug = '';
        delete form.slug.dataset.locked;
        await fillForm(emptyPayload());
        await openEditor(true);
      });
      document.getElementById('btn-back').addEventListener('click', () => {
        show(editorPanel, false);
        show(listPanel, true);
      });
      document.getElementById('list-search').addEventListener('input', (e) => renderList(e.target.value));
      form.appName.addEventListener('input', () => {
        if (mode === 'create' && !form.slug.dataset.locked) form.slug.value = slugify(form.appName.value);
      });
      form.slug.addEventListener('input', () => {
        form.slug.dataset.locked = '1';
        form.slug.value = normalizeSlug(form.slug.value);
      });
      form.icon.addEventListener('input', updateMediaPreviews);
      form.featuredImage.addEventListener('input', updateMediaPreviews);
      form.screenshots.addEventListener('input', renderShotPreviews);

      document.getElementById('shot-previews').addEventListener('click', (e) => {
        const i = e.target.getAttribute('data-shot-del');
        if (i == null) return;
        const urls = shotList();
        urls.splice(Number(i), 1);
        setShots(urls);
      });

      document.getElementById('btn-icon-upload').addEventListener('click', () => document.getElementById('icon-file').click());
      document.getElementById('btn-featured-upload').addEventListener('click', () => document.getElementById('featured-file').click());
      document.getElementById('btn-shot-upload').addEventListener('click', () => document.getElementById('shot-file').click());
      document.getElementById('btn-shot-url').addEventListener('click', () => {
        const url = prompt('Image URL');
        if (!url) return;
        setShots(shotList().concat([url.trim()]));
      });
      document.getElementById('btn-faq-add').addEventListener('click', () => addFaqRow({ q: '', a: '' }));
      document.getElementById('faq-list').addEventListener('click', (e) => {
        if (!e.target.getAttribute('data-faq-del')) return;
        e.target.closest('.faq-row')?.remove();
      });

      document.getElementById('icon-file').addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (!file) return;
        try {
          form.icon.value = await uploadFile(file, document.getElementById('icon-status'));
          updateMediaPreviews();
        } catch (err) {
          document.getElementById('icon-status').textContent = err.message;
        }
        e.target.value = '';
      });
      document.getElementById('featured-file').addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (!file) return;
        try {
          form.featuredImage.value = await uploadFile(file, document.getElementById('featured-status'));
          updateMediaPreviews();
        } catch (err) {
          document.getElementById('featured-status').textContent = err.message;
        }
        e.target.value = '';
      });
      document.getElementById('shot-file').addEventListener('change', async (e) => {
        const files = [...e.target.files];
        if (!files.length) return;
        const status = document.getElementById('shot-status');
        try {
          const urls = shotList();
          for (const file of files) {
            urls.push(await uploadFile(file, status));
          }
          setShots(urls);
        } catch (err) {
          status.textContent = err.message;
        }
        e.target.value = '';
      });

      listEl.addEventListener('click', async (e) => {
        const shareSlug = e.target.getAttribute('data-share-slug');
        const edit = e.target.getAttribute('data-edit');
        const del = e.target.getAttribute('data-del');
        if (shareSlug) {
          const row = rows.find((r) => r.slug === shareSlug);
          if (row) openShareModal(row);
          return;
        }
        if (edit) {
          const ok = await requireAdminPassword('edit this article');
          if (!ok) return;
          const entry = await api('/api/admin/apps/' + edit);
          currentSlug = edit;
          form.slug.dataset.locked = '1';
          await fillForm({ ...entry.data, sha: entry.sha });
          await openEditor(false);
        }
        if (del) {
          const ok = await requireAdminPassword('delete this article');
          if (!ok) return;
          await api('/api/admin/apps/' + del + '?sha=' + e.target.getAttribute('data-sha'), { method: 'DELETE' });
          await loadList();
        }
      });

      async function persistArticle(asDraft) {
        setError('editor-error', '');
        const success = document.getElementById('editor-success');
        success.textContent = '';
        show(success, false);
        if (typeof tinymce !== 'undefined') tinymce.triggerSave();
        const payload = readForm(asDraft);
        if (!payload.slug && payload.appName) payload.slug = slugify(payload.appName);
        if (!payload.slug) return setError('editor-error', 'Slug or app name is required');
        if (!asDraft) {
          if (!payload.appName?.trim()) return setError('editor-error', 'App name is required to publish');
          if (!payload.title?.trim()) return setError('editor-error', 'Title is required to publish');
          if (!payload.icon?.trim() || payload.icon === '/favicon.svg') {
            return setError('editor-error', 'Real icon URL is required to publish (not the draft placeholder)');
          }
          if (!payload.featuredImage?.trim() || payload.featuredImage.includes('hero-mod-1280')) {
            return setError('editor-error', 'Featured image URL is required to publish');
          }
          if (!payload.downloadUrl?.trim() || payload.downloadUrl === 'https://apkmoby.com/') {
            return setError('editor-error', 'Download URL is required to publish');
          }
        }
        const saveBtn = document.getElementById('btn-save');
        const draftBtn = document.getElementById('btn-draft');
        saveBtn.disabled = true;
        draftBtn.disabled = true;
        saveBtn.textContent = asDraft ? 'Save / Publish' : 'Publishing…';
        draftBtn.textContent = asDraft ? 'Saving draft…' : 'Save Draft';
        try {
          const exists = mode === 'edit' && currentSlug;
          if (!exists) {
            await api('/api/admin/apps/' + payload.slug, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
            mode = 'edit';
            currentSlug = payload.slug;
            form.slug.dataset.locked = '1';
          } else {
            await api('/api/admin/apps/' + currentSlug, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
          }
          form.dataset.draft = asDraft ? '1' : '0';
          if (asDraft) {
            success.textContent =
              'Draft saved. You can close the panel and finish this article later from the list.';
            show(success, true);
            await loadList();
            // Refresh sha so next save updates instead of conflicting
            try {
              const entry = await api('/api/admin/apps/' + payload.slug);
              form.sha.value = entry.sha || '';
              await fillForm({ ...entry.data, sha: entry.sha });
            } catch {}
          } else {
            success.innerHTML =
              'Published live. Open: <a class="underline text-cyan-300" target="_blank" rel="noopener" href="https://apkmoby.com/' +
              payload.slug +
              '">https://apkmoby.com/' +
              payload.slug +
              '</a> — wait ~30s then hard-refresh homepage (Ctrl/Cmd+Shift+R). Screenshots saved: ' +
              payload.screenshots.length;
            show(success, true);
            window.open('https://apkmoby.com/' + payload.slug, '_blank', 'noopener');
            await loadList();
            setTimeout(() => {
              show(editorPanel, false);
              show(listPanel, true);
            }, 4000);
          }
        } catch (err) {
          setError('editor-error', err.message);
        } finally {
          saveBtn.disabled = false;
          draftBtn.disabled = false;
          saveBtn.textContent = 'Save / Publish';
          draftBtn.textContent = 'Save Draft';
        }
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        await persistArticle(false);
      });

      document.getElementById('btn-draft').addEventListener('click', async () => {
        await persistArticle(true);
      });

      document.getElementById('btn-duplicate').addEventListener('click', () => {
        form.sha.value = '';
        form.slug.value = (normalizeSlug(form.slug.value) || 'app') + '-copy';
        form.slug.dataset.locked = '1';
        form.dataset.draft = '1';
        mode = 'create';
        currentSlug = '';
      });

      document.getElementById('btn-delete').addEventListener('click', async () => {
        if (mode !== 'edit') return;
        const ok = await requireAdminPassword('delete this article');
        if (!ok) return;
        await api('/api/admin/apps/' + currentSlug + '?sha=' + form.sha.value, { method: 'DELETE' });
        await loadList();
        show(editorPanel, false);
        show(listPanel, true);
      });

      api('/api/admin/session')
        .then(async (data) => {
          adminEmail = String(data.email || '').trim().toLowerCase();
          show(loginView, false);
          show(appView, true);
          await loadList();
        })
        .catch(() => {});
    </script>
  </body>
</html>
