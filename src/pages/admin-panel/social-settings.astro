---
import AdminLayout from '../../layouts/AdminLayout.astro';

const platforms = [
  'Facebook',
  'Twitter / X',
  'Instagram',
  'Telegram',
  'WhatsApp',
  'YouTube',
  'TikTok',
  'LinkedIn',
  'Pinterest',
  'Reddit',
  'Discord',
  'Threads',
  'Snapchat',
  'Tumblr',
  'VK',
  'Medium',
  'GitHub',
  'Other',
];
---

<AdminLayout title="Social Settings · Admin">
  <style is:global>
    #login-view.hidden,
    #app-view.hidden,
    #add-panel.hidden,
    #custom-platform-wrap.hidden,
    #btn-cancel-edit.hidden {
      display: none !important;
    }
  </style>

  <div id="login-view" class="mx-auto flex min-h-screen max-w-md flex-col justify-center px-4">
    <h1 class="text-2xl font-extrabold">Publisher login</h1>
    <p class="mt-2 text-sm text-slate-400">Private console. Not linked from the public site.</p>
    <form id="login-form" class="mt-8 space-y-4">
      <label class="block text-sm">
        Email
        <input name="email" type="email" required class="mt-1 w-full rounded-xl border border-white/10 bg-ink-card px-3 py-2.5" />
      </label>
      <label class="block text-sm">
        Password
        <input name="password" type="password" required class="mt-1 w-full rounded-xl border border-white/10 bg-ink-card px-3 py-2.5" />
      </label>
      <p id="login-error" class="hidden text-sm text-red-400"></p>
      <button class="w-full rounded-xl bg-cyan-400 py-2.5 text-sm font-bold text-ink">Sign in</button>
    </form>
  </div>

  <div id="app-view" class="hidden">
    <header class="sticky top-0 z-20 border-b border-white/10 bg-ink/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3">
        <p class="font-bold">Apk Moby · Admin</p>
        <nav class="flex flex-wrap items-center gap-2 text-sm">
          <a href="/admin-panel" class="rounded-lg border border-white/15 px-3 py-1.5 text-slate-300 hover:text-white">Articles</a>
          <a href="/admin-panel/apk-files" class="rounded-lg border border-white/15 px-3 py-1.5 text-slate-300 hover:text-white">APK Files</a>
          <a href="/admin-panel/social-settings" class="rounded-lg bg-white/10 px-3 py-1.5 font-medium text-cyan-300">Social Settings</a>
          <button id="btn-new-link" type="button" class="rounded-lg bg-cyan-400 px-3 py-1.5 text-sm font-bold text-ink">+ Add link</button>
          <button id="btn-logout" type="button" class="rounded-lg border border-white/15 px-3 py-1.5 text-sm">Logout</button>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-8">
      <section id="add-panel" class="mb-8 hidden rounded-2xl border border-white/10 bg-ink-card/60 p-5">
        <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
          <div>
            <h2 class="text-xl font-bold" id="form-heading">Add social link</h2>
            <p class="mt-1 text-sm text-slate-400">Choose a platform, paste your page/channel URL, then save. Links stay on this page only.</p>
          </div>
          <button type="button" id="btn-close-panel" class="rounded-lg border border-white/15 px-3 py-1.5 text-sm">Close</button>
        </div>
        <form id="social-form" class="grid gap-4 md:grid-cols-2">
          <input type="hidden" id="edit-id" value="" />
          <label class="text-sm">
            Platform
            <select id="platform" required class="mt-1 w-full rounded-lg border border-white/10 bg-ink px-3 py-2">
              <option value="">Select platform…</option>
              {platforms.map((p) => <option value={p}>{p}</option>)}
            </select>
          </label>
          <label id="custom-platform-wrap" class="hidden text-sm">
            Custom platform name
            <input id="custom-platform" type="text" placeholder="e.g. Quora, Mastodon, Line" class="mt-1 w-full rounded-lg border border-white/10 bg-ink px-3 py-2" />
          </label>
          <label class="text-sm md:col-span-2">
            Page / channel URL
            <input id="url" type="url" required placeholder="https://…" class="mt-1 w-full rounded-lg border border-white/10 bg-ink px-3 py-2" />
          </label>
          <div class="md:col-span-2 flex flex-wrap gap-3">
            <button type="submit" id="btn-save-link" class="rounded-xl bg-cyan-400 px-5 py-2.5 text-sm font-bold text-ink">
              <span id="btn-save-label">Save link</span>
            </button>
            <button type="button" id="btn-cancel-edit" class="hidden rounded-xl border border-white/15 px-5 py-2.5 text-sm">Cancel edit</button>
          </div>
          <p id="social-msg" class="hidden md:col-span-2 text-sm text-emerald-300"></p>
          <p id="social-err" class="hidden md:col-span-2 text-sm text-red-400"></p>
        </form>
      </section>

      <section id="list-panel">
        <div class="mb-4 flex items-center justify-between gap-3">
          <h2 class="text-xl font-bold">Saved profiles</h2>
          <input id="list-search" type="search" placeholder="Search…" class="w-56 rounded-lg border border-white/10 bg-ink-card px-3 py-2 text-sm" />
        </div>
        <div id="links-list" class="overflow-hidden rounded-2xl border border-white/10"></div>
      </section>
    </main>
  </div>

  <script is:inline>
    const STORAGE_KEY = 'apkmoby.social.links.v2';
    const loginView = document.getElementById('login-view');
    const appView = document.getElementById('app-view');
    const addPanel = document.getElementById('add-panel');
    const form = document.getElementById('social-form');
    const platformEl = document.getElementById('platform');
    const customWrap = document.getElementById('custom-platform-wrap');
    const customEl = document.getElementById('custom-platform');
    const urlEl = document.getElementById('url');
    const editIdEl = document.getElementById('edit-id');
    const listEl = document.getElementById('links-list');
    const searchEl = document.getElementById('list-search');
    const btnSaveLabel = document.getElementById('btn-save-label');
    const btnCancelEdit = document.getElementById('btn-cancel-edit');
    const formHeading = document.getElementById('form-heading');

    const show = (el, on) => {
      if (!el) return;
      el.classList.toggle('hidden', !on);
    };
    const setMsg = (id, msg) => {
      const n = document.getElementById(id);
      if (!n) return;
      n.textContent = msg || '';
      show(n, !!msg);
    };

    async function api(url, opts) {
      const res = await fetch(url, { credentials: 'same-origin', ...opts });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Request failed');
      return data;
    }

    function uid() {
      return 's' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
    }

    function loadLinks() {
      try {
        const raw = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
        if (Array.isArray(raw)) return raw;
        const legacy = JSON.parse(localStorage.getItem('apkmoby.social.settings.v1') || 'null');
        if (legacy && typeof legacy === 'object') {
          const map = {
            facebook: 'Facebook',
            twitter: 'Twitter / X',
            telegram: 'Telegram',
            whatsapp: 'WhatsApp',
            linkedin: 'LinkedIn',
            pinterest: 'Pinterest',
          };
          const migrated = Object.keys(map)
            .filter((k) => legacy[k])
            .map((k) => ({ id: uid(), platform: map[k], url: String(legacy[k]).trim() }));
          if (migrated.length) saveLinks(migrated);
          return migrated;
        }
        return [];
      } catch {
        return [];
      }
    }

    function saveLinks(list) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
    }

    function escapeHtml(s) {
      return String(s || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function openAddPanel(editing) {
      show(addPanel, true);
      if (!editing) {
        resetFormFields();
        formHeading.textContent = 'Add social link';
        btnSaveLabel.textContent = 'Save link';
      }
      addPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function closeAddPanel() {
      show(addPanel, false);
      resetFormFields();
    }

    function resetFormFields() {
      editIdEl.value = '';
      platformEl.value = '';
      customEl.value = '';
      urlEl.value = '';
      show(customWrap, false);
      customEl.required = false;
      btnSaveLabel.textContent = 'Save link';
      formHeading.textContent = 'Add social link';
      show(btnCancelEdit, false);
      setMsg('social-msg', '');
      setMsg('social-err', '');
    }

    function renderList(filter) {
      const q = (filter || '').toLowerCase();
      const links = loadLinks().filter((item) => {
        if (!q) return true;
        return (item.platform + ' ' + item.url).toLowerCase().includes(q);
      });
      if (!links.length) {
        listEl.innerHTML = q
          ? '<p class="p-6 text-sm text-slate-400">No matches.</p>'
          : '<p class="p-6 text-sm text-slate-400">No social links yet. Click <strong class="text-slate-200">+ Add link</strong> to add your first profile.</p>';
        return;
      }
      listEl.innerHTML =
        '<table class="w-full text-sm"><thead class="bg-white/5 text-left text-slate-400"><tr><th class="px-4 py-3">Platform</th><th class="px-4 py-3">Link</th><th class="px-4 py-3"></th></tr></thead><tbody>' +
        links
          .map((item) => {
            const safeUrl = escapeHtml(item.url);
            const short = item.url.length > 56 ? escapeHtml(item.url.slice(0, 56)) + '…' : safeUrl;
            return (
              '<tr class="border-t border-white/10"><td class="px-4 py-3 font-medium">' +
              escapeHtml(item.platform) +
              '</td><td class="px-4 py-3"><a class="text-cyan-300 hover:underline break-all" href="' +
              safeUrl +
              '" target="_blank" rel="noopener noreferrer">' +
              short +
              '</a></td><td class="px-4 py-3 text-right whitespace-nowrap space-x-2">' +
              '<button type="button" data-edit="' +
              escapeHtml(item.id) +
              '" class="text-cyan-300">Edit</button>' +
              '<button type="button" data-del="' +
              escapeHtml(item.id) +
              '" class="text-red-300">Delete</button></td></tr>'
            );
          })
          .join('') +
        '</tbody></table>';
    }

    platformEl.addEventListener('change', () => {
      const isOther = platformEl.value === 'Other';
      show(customWrap, isOther);
      customEl.required = isOther;
      if (!isOther) customEl.value = '';
    });

    document.getElementById('btn-new-link').addEventListener('click', () => openAddPanel(false));
    document.getElementById('btn-close-panel').addEventListener('click', closeAddPanel);
    btnCancelEdit.addEventListener('click', () => {
      resetFormFields();
      closeAddPanel();
    });
    searchEl.addEventListener('input', (e) => renderList(e.target.value));

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      setMsg('social-err', '');
      setMsg('social-msg', '');
      let platform = platformEl.value;
      if (platform === 'Other') {
        platform = customEl.value.trim();
        if (!platform) {
          setMsg('social-err', 'Enter a custom platform name');
          return;
        }
      }
      const url = urlEl.value.trim();
      if (!platform || !url) {
        setMsg('social-err', 'Platform and URL are required');
        return;
      }
      try {
        const parsed = new URL(url);
        if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') throw new Error('bad');
      } catch {
        setMsg('social-err', 'Enter a valid http(s) URL');
        return;
      }

      const links = loadLinks();
      const editId = editIdEl.value;
      if (editId) {
        const idx = links.findIndex((l) => l.id === editId);
        if (idx >= 0) links[idx] = { ...links[idx], platform, url };
        setMsg('social-msg', 'Link updated.');
      } else {
        links.push({ id: uid(), platform, url, createdAt: new Date().toISOString() });
        setMsg('social-msg', 'Link added.');
      }
      saveLinks(links);
      closeAddPanel();
      renderList(searchEl.value);
    });

    listEl.addEventListener('click', (e) => {
      const editId = e.target.getAttribute('data-edit');
      const delId = e.target.getAttribute('data-del');
      const links = loadLinks();
      if (editId) {
        const item = links.find((l) => l.id === editId);
        if (!item) return;
        openAddPanel(true);
        editIdEl.value = item.id;
        const known = [...platformEl.options].some((o) => o.value === item.platform);
        if (known) {
          platformEl.value = item.platform;
          show(customWrap, false);
          customEl.required = false;
          customEl.value = '';
        } else {
          platformEl.value = 'Other';
          show(customWrap, true);
          customEl.required = true;
          customEl.value = item.platform;
        }
        urlEl.value = item.url;
        btnSaveLabel.textContent = 'Update link';
        formHeading.textContent = 'Edit social link';
        show(btnCancelEdit, true);
        return;
      }
      if (delId) {
        if (!confirm('Delete this social link?')) return;
        saveLinks(links.filter((l) => l.id !== delId));
        if (editIdEl.value === delId) closeAddPanel();
        renderList(searchEl.value);
      }
    });

    document.getElementById('login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      setMsg('login-error', '');
      const fd = new FormData(e.target);
      try {
        await api('/api/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: fd.get('email'), password: fd.get('password') }),
        });
        show(loginView, false);
        show(appView, true);
        renderList('');
      } catch (err) {
        setMsg('login-error', err.message);
      }
    });

    document.getElementById('btn-logout').addEventListener('click', async () => {
      await api('/api/admin/logout', { method: 'POST' });
      location.reload();
    });

    api('/api/admin/session')
      .then(() => {
        show(loginView, false);
        show(appView, true);
        renderList('');
      })
      .catch(() => {
        show(loginView, true);
        show(appView, false);
      });
  </script>
</AdminLayout>
