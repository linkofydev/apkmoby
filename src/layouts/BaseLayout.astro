---
import '../styles/global.css';
import { SITE } from '../config';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  robots?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
}

const props = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="p:domain_verify" content="9df06aa0b1f1eeac0d0429e8edbfada1" />
    <script is:inline>
      (function () {
        try {
          // Default: light. Dark only when the visitor explicitly chose it.
          var theme = localStorage.getItem('theme') || 'light';
          document.documentElement.classList.toggle('dark', theme === 'dark');
        } catch (e) {}
      })();
    </script>
    <SEO {...props} />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-800 antialiased dark:bg-ink dark:text-slate-100">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-cyan-400 focus:px-3 focus:py-2 focus:text-ink"
    >
      Skip to content
    </a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
